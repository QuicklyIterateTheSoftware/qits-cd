<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-cd</artifactId>
        <version>2026.802.182307</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The deployment domain: environments, the applications they track, and the recorded
         deployments. A plain library jar: entities, persistence, control, mapper, dto — NO
         web/JAX-RS (that is `service`). Environments reference repositories and epics by *String
         id/name* (never a JPA @ManyToOne into another context's tables); this context talks to the
         rest of qits only over the surfaces it declares: the intake payloads it receives and its
         own docker CLI shell-out (behind the DeploymentDriver seam, whose sole implementation is
         service/dockerhost).

         It owns its OWN named datasource + persistence unit + Flyway lineage — a separate
         file-based H2 under ~/.qits/data/cd (see src/main/resources/META-INF/microprofile-config.properties).

         The directory is `cd/` (the ci/service shape of the sibling repos) while the artifactId is
         `qits-cd-domain`: this module is the domain layer of the qits-cd repo, and
         `eu.wohlben.qits:qits-cd-cd` would be nonsense. -->
    <artifactId>qits-cd-domain</artifactId>
    <name>qits-cd :: domain</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <!-- ObjectMapper bean availability for consumers (no REST needed). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- The consuming Quarkus app needs an index of this jar's beans and entities. -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
